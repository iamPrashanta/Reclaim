# Reclaim default settings.
# Do not edit this file for your own machine: copy the keys you want to change into
# config\settings.local.psd1 (ignored by git). Values there override these.
@{
    # Where reports, history, logs, the compiled engine and remembered choices are kept.
    DataDir    = '%LOCALAPPDATA%\Reclaim'
    ReportsDir = '%LOCALAPPDATA%\Reclaim\reports'

    # Old project folders: a project counts as "stale" when nothing in it changed for this many days.
    StaleDays = 30

    # Your code folders, scanned by "Old project folders" (you can also type them in the menu).
    DevRoots = @()          # example: @('D:\Code', 'C:\Users\me\source\repos')

    # Space hogs
    ScanDepth      = 3      # folder levels summarised below the drive or folder you scan
    TopCount       = 30     # biggest files listed
    LargeFileMinMB = 100    # files smaller than this are not listed as big files
    OldFileDays    = 365    # "not touched for a year" summary

    # Duplicate files
    DuplicateMinMB    = 10
    DuplicateSkipDirs = @('Windows', 'Program Files', 'Program Files (x86)', 'ProgramData', 'AppData',
                          '$Recycle.Bin', 'System Volume Information', 'node_modules', '.git', '.venv', 'venv',
                          '.dart_tool', '.gradle', '.next', '.nuxt', '.turbo', '__pycache__', 'target', 'obj')

    # Low-space alert (scheduled check)
    LowSpaceGB = 20

    # Targets you never want to see (ids from `reclaim -List`)
    ExcludeTargets = @()

    # Paths Reclaim must never touch, whatever a target says (prefix match)
    ExcludePaths = @()

    # Build folders that can be rebuilt from the project files next to them.
    # Markers: at least one must exist in the parent folder ('*' = no marker needed).
    DevArtifacts = @(
        @{ Name = 'node_modules';  Markers = @('package.json');                                   Kind = 'Node packages';     Risk = 'Safe';     Restore = 'npm / pnpm / yarn install' }
        @{ Name = '.next';         Markers = @('package.json');                                   Kind = 'Next.js build';     Risk = 'Safe';     Restore = 'next dev / next build' }
        @{ Name = '.nuxt';         Markers = @('package.json');                                   Kind = 'Nuxt build';        Risk = 'Safe';     Restore = 'nuxt dev / nuxt build' }
        @{ Name = '.svelte-kit';   Markers = @('package.json');                                   Kind = 'SvelteKit build';   Risk = 'Safe';     Restore = 'vite dev' }
        @{ Name = '.turbo';        Markers = @('package.json', 'turbo.json');                     Kind = 'Turborepo cache';   Risk = 'Safe';     Restore = 'turbo run build' }
        @{ Name = '.parcel-cache'; Markers = @('package.json');                                   Kind = 'Parcel cache';      Risk = 'Safe';     Restore = 'automatic' }
        @{ Name = '.angular';      Markers = @('angular.json');                                   Kind = 'Angular cache';     Risk = 'Safe';     Restore = 'automatic' }
        @{ Name = 'target';        Markers = @('Cargo.toml', 'pom.xml');                          Kind = 'Rust / Maven build'; Risk = 'Safe';    Restore = 'cargo build / mvn package' }
        @{ Name = 'build';         Markers = @('build.gradle', 'build.gradle.kts', 'pubspec.yaml'); Kind = 'Gradle / Flutter build'; Risk = 'Safe'; Restore = 'gradle build / flutter build' }
        @{ Name = '.gradle';       Markers = @('build.gradle', 'build.gradle.kts', 'settings.gradle', 'settings.gradle.kts'); Kind = 'Gradle project cache'; Risk = 'Safe'; Restore = 'automatic' }
        @{ Name = '.cxx';          Markers = @('build.gradle', 'build.gradle.kts');               Kind = 'Android NDK build'; Risk = 'Safe';     Restore = 'gradle build' }
        @{ Name = '.dart_tool';    Markers = @('pubspec.yaml');                                   Kind = 'Dart tool cache';   Risk = 'Safe';     Restore = 'flutter pub get' }
        @{ Name = 'bin';           Markers = @('*.csproj', '*.fsproj', '*.vbproj');               Kind = '.NET output';       Risk = 'Moderate'; Restore = 'dotnet build' }
        @{ Name = 'obj';           Markers = @('*.csproj', '*.fsproj', '*.vbproj');               Kind = '.NET intermediate'; Risk = 'Safe';     Restore = 'dotnet build' }
        @{ Name = '__pycache__';   Markers = @('*');                                              Kind = 'Python bytecode';   Risk = 'Safe';     Restore = 'automatic' }
        @{ Name = '.pytest_cache'; Markers = @('*');                                              Kind = 'pytest cache';      Risk = 'Safe';     Restore = 'automatic' }
        @{ Name = '.mypy_cache';   Markers = @('*');                                              Kind = 'mypy cache';        Risk = 'Safe';     Restore = 'automatic' }
        @{ Name = '.ruff_cache';   Markers = @('*');                                              Kind = 'ruff cache';        Risk = 'Safe';     Restore = 'automatic' }
        @{ Name = '.tox';          Markers = @('tox.ini', 'pyproject.toml');                      Kind = 'tox environments';  Risk = 'Safe';     Restore = 'tox' }
        @{ Name = '.venv';         Markers = @('pyproject.toml', 'requirements.txt', 'setup.py', 'Pipfile'); Kind = 'Python virtualenv'; Risk = 'Careful'; Restore = 'python -m venv .venv + pip install' }
        @{ Name = 'venv';          Markers = @('pyproject.toml', 'requirements.txt', 'setup.py', 'Pipfile'); Kind = 'Python virtualenv'; Risk = 'Careful'; Restore = 'python -m venv venv + pip install' }
        @{ Name = 'Pods';          Markers = @('Podfile');                                        Kind = 'CocoaPods';         Risk = 'Safe';     Restore = 'pod install' }
        @{ Name = 'vendor';        Markers = @('composer.json');                                  Kind = 'Composer packages'; Risk = 'Moderate'; Restore = 'composer install' }
        @{ Name = '.terraform';    Markers = @('*.tf');                                           Kind = 'Terraform providers'; Risk = 'Safe';   Restore = 'terraform init' }
    )

    # Folders never entered while looking for build folders.
    DevSkipDirs = @('.git', '.hg', '.svn', '$Recycle.Bin', 'System Volume Information', 'Windows', 'Program Files', 'Program Files (x86)', 'AppData')
}
